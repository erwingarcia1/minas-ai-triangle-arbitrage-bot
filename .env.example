# ============================================================================
# triarb environment template
#
# Phase 1 (observer) uses ONLY public market-data endpoints and needs NO keys.
# These variables exist for later phases. Copy to `.env` (gitignored) and fill
# in only when you reach Phase 2+.
#
# Key-permission checklist (verify in the exchange UI before creating keys):
#   [ ] Spot trade permission ONLY
#   [ ] Withdrawals DISABLED
#   [ ] Transfers DISABLED
#   [ ] IP whitelist set to the machine running this bot
# This repository intentionally contains no withdrawal or transfer code.
# ============================================================================

# --- Bitget (default venue) ---
#BITGET_API_KEY=
#BITGET_API_SECRET=
#BITGET_API_PASSPHRASE=

# --- Binance ---
#BINANCE_API_KEY=
#BINANCE_API_SECRET=

# --- Bybit ---
#BYBIT_API_KEY=
#BYBIT_API_SECRET=

# --- OKX ---
#OKX_API_KEY=
#OKX_API_SECRET=
#OKX_API_PASSPHRASE=

# Live trading (Phase 3+) additionally requires BOTH the --live CLI flag AND:
#CONFIRM_LIVE=yes
